// Template for local development configuration.
//
// SETUP: copy this file to `appsettings.Local.json` in the same directory and fill in
// the values. `appsettings.Local.json` is gitignored and must NEVER be committed.
//
// Prefer .NET User Secrets over a file for anything genuinely secret:
//   dotnet user-secrets init
//   dotnet user-secrets set "S3:SpacesSecret" "<value>"
{
    "ConnectionStrings": {
        "PostgresConnection": "Server=localhost;Port=5432;Database=noizera;Username=postgres;Password=REPLACE_WITH_LOCAL_DB_PASSWORD"
    },
    "S3": {
        "SpacesKey": "REPLACE_WITH_S3_KEY",
        "SpacesSecret": "REPLACE_WITH_S3_SECRET",
        "ServiceUrl": "https://ams3.digitaloceanspaces.com"
    },
    "S3Bucket": {
        "BucketName": "noizera-local"
    },
    "BrevoApiKey": "REPLACE_WITH_BREVO_API_KEY",
    "EventSettings": {
        "HandleAllEvents": false,
        "EventsToHandle": [ "AlbumSubmittedEvent" ]
    },
    "DataFolderPath": "C:/noizera-data", // prod, dev: /home/printsev/noizera-data
    "IsDebug": true,
    "DockerUrl": "npipe://./pipe/docker_engine",
    "SeqUrl": "http://localhost:5341",
    "SeqApiKey": "",
    "StripeApiKey": "REPLACE_WITH_STRIPE_TEST_KEY"
}
